<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Base.Theme.KorotaevaHomework" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="myInputBackground">@color/bg_day_secondary</item>
        <item name="myBorderBackground">@color/border_day</item>
        <item name="colorOnSecondary">@color/font_day_disable</item>
        <item name="colorOnBackground">@color/font_day_secondary</item>
    </style>

    <style name="CustomTextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="shapeAppearanceOverlay">@style/RoundedTextInputLayout</item>
        <item name="boxStrokeColor">@color/edit_text_stroke_selector</item>
        <item name="hintTextColor">?attr/colorOnBackground</item>
        <item name="cursorColor">?attr/colorOnSurface</item>
        <item name="boxBackgroundColor">@color/edit_text_bg_selector</item>
        <item name="android:textColorHint">?attr/colorOnSecondary</item>
    </style>

    <style name="RoundedTextInputLayout" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>

    <style name="Theme.KorotaevaHomework" parent="Base.Theme.KorotaevaHomework" />

    <attr name="myInputBackground" format="color" />
    <attr name="myBorderBackground" format="color" />
</resources>